generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum Categoria {
  MATERIAL
  PRODUCTO
}

enum Unidad {
  METRO
  KG
  CONO
  UNIDAD
}

enum MovimientoTipo {
  COMPRA
  CONSUMO
  PRODUCCION
  VENTA
  AJUSTE
}

enum OrdenEstado {
  ABIERTA
  CERRADA
  CANCELADA
}

/// Un cliente del SaaS (un emprendimiento textil). Todos los datos de negocio
/// cuelgan de acá — es la unidad de aislamiento entre clientes.
model Negocio {
  id        String   @id @default(uuid())
  nombre    String
  activo    Boolean  @default(true)
  createdAt DateTime @default(now())

  usuarios          User[]
  items             Item[]
  operarios         Operario[]
  movimientos       Movimiento[]
  ordenesProduccion OrdenProduccion[]
  secuenciasCodigo  SecuenciaCodigo[]

  @@map("negocios")
}

model User {
  id             String   @id @default(uuid())
  negocioId      String
  email          String   @unique
  passwordHash   String
  nombre         String
  /// Numero de WhatsApp del dueño (formato "whatsapp:+549..."), para que el
  /// bot identifique a que negocio pertenece un mensaje entrante.
  whatsappNumber String?  @unique
  /// Puede dar de alta negocios nuevos via /admin. Solo el fundador del SaaS.
  esSuperAdmin   Boolean  @default(false)
  activo         Boolean  @default(true)
  createdAt      DateTime @default(now())

  negocio Negocio @relation(fields: [negocioId], references: [id])

  @@map("users")
}

model Item {
  id          String   @id @default(uuid())
  negocioId   String
  /// Código corto autogenerado (ej. "MAT-0007", "PROD-0012") — identificador
  /// rápido para cuando el nombre + color no alcanza para distinguir variantes
  /// (ej. dos productos del mismo color pero de tela distinta). Nunca lo
  /// escribe el usuario, lo asigna ItemsRepository.create() vía SecuenciaCodigo.
  codigo      String
  /// Agrupador opcional, libre, por encima de "nombre" — ej. "Hilo" agrupando
  /// "Poliéster"/"Algodón"/"Sedalina" como nombres separados que si no fuera
  /// por este campo no tendrían ninguna relación entre sí en la base. La
  /// mayoría de los items no lo necesitan (Corderoy/Gabardina ya agrupan sus
  /// variantes por color vía nombre solo) y queda null.
  grupo       String?
  nombre      String
  categoria   Categoria
  unidad      Unidad
  tieneColor  Boolean  @default(false)
  colorNombre String?
  imagenUrl   String?
  /// Umbral para avisar "te estás por quedar sin esto". Null = sin alerta configurada.
  stockMinimo Decimal? @db.Decimal(10, 2)
  activo      Boolean  @default(true)
  createdAt   DateTime @default(now())

  negocio     Negocio      @relation(fields: [negocioId], references: [id])
  movimientos Movimiento[]

  @@unique([negocioId, nombre, colorNombre])
  @@unique([negocioId, codigo])
  @@index([negocioId])
  @@map("items")
}

/// Contador atómico por negocio+categoría para generar Item.codigo en orden
/// ("MAT-0001", "MAT-0002", ...) sin colisiones bajo cargas concurrentes.
model SecuenciaCodigo {
  id          String    @id @default(uuid())
  negocioId   String
  categoria   Categoria
  ultimoValor Int       @default(0)

  negocio Negocio @relation(fields: [negocioId], references: [id])

  @@unique([negocioId, categoria])
  @@map("secuencias_codigo")
}

model Operario {
  id        String   @id @default(uuid())
  negocioId String
  nombre    String
  activo    Boolean  @default(true)
  createdAt DateTime @default(now())

  negocio           Negocio           @relation(fields: [negocioId], references: [id])
  movimientos       Movimiento[]
  ordenesProduccion OrdenProduccion[]

  @@index([negocioId])
  @@map("operarios")
}

model OrdenProduccion {
  id            String      @id @default(uuid())
  negocioId     String
  operarioId    String
  fecha         DateTime    @default(now())
  observaciones String?
  /// ABIERTA hasta que se registra la recepción de producto terminado (o se
  /// cancela). Antes se inferia el estado a partir de si tenia movimientos
  /// PRODUCCION asociados — fragil para filtrar "ordenes abiertas de un
  /// operario", que ahora es un filtro directo por esta columna.
  estado        OrdenEstado @default(ABIERTA)
  cerradaEn     DateTime?
  createdAt     DateTime    @default(now())

  negocio     Negocio      @relation(fields: [negocioId], references: [id])
  operario    Operario     @relation(fields: [operarioId], references: [id])
  movimientos Movimiento[]

  @@index([negocioId])
  @@index([operarioId])
  @@map("ordenes_produccion")
}

model Movimiento {
  id                String         @id @default(uuid())
  negocioId         String
  itemId            String
  operarioId        String?
  ordenProduccionId String?
  tipo              MovimientoTipo
  cantidad          Decimal        @db.Decimal(10, 2)
  /// Precio total pagado/cobrado (COMPRA y VENTA). Null en el resto de los
  /// tipos y en movimientos donde no se informó precio.
  montoTotal        Decimal?       @db.Decimal(10, 2)
  fecha             DateTime       @default(now())
  observaciones     String?
  createdAt         DateTime       @default(now())

  negocio         Negocio          @relation(fields: [negocioId], references: [id])
  item            Item             @relation(fields: [itemId], references: [id])
  operario        Operario?        @relation(fields: [operarioId], references: [id])
  ordenProduccion OrdenProduccion? @relation(fields: [ordenProduccionId], references: [id])

  @@index([negocioId])
  @@index([itemId])
  @@index([operarioId])
  @@index([ordenProduccionId])
  @@map("movimientos")
}

/// Estado de la conversación de WhatsApp por número de teléfono. Reemplaza el
/// Map en memoria de la versión NestJS — Vercel Functions no comparten
/// memoria entre invocaciones, así que la sesión tiene que persistir en la base.
model SesionWhatsapp {
  telefono      String   @id
  estado        Json
  actualizadoEn DateTime @updatedAt

  @@map("sesiones_whatsapp")
}

/// Contador de intentos para rate limiting (login, alta self-service), por la
/// misma razón que SesionWhatsapp: en serverless no hay memoria compartida
/// entre requests para llevar la cuenta en RAM.
model IntentoRateLimit {
  clave      String   @id
  intentos   Int      @default(1)
  ventanaFin DateTime

  @@map("intentos_rate_limit")
}
