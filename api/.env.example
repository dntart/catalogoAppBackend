# Supabase Postgres, schema propio de este SaaS (ver skill saas-shared-infra:
# un solo proyecto de Supabase, un schema por producto). Usar el connection
# string del "Session Pooler" (IPv4), no el directo.
DATABASE_URL="postgresql://postgres.xxxxxxxxxxxx:[PASSWORD]@aws-0-sa-east-1.pooler.supabase.com:5432/postgres?schema=stockasist"

JWT_SECRET="reemplazar-con-un-secreto-largo-y-aleatorio"
JWT_EXPIRES_IN="7d"

# Bot de WhatsApp (Twilio Sandbox o número propio) — ver api/README.md
TWILIO_ACCOUNT_SID="ACxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx"
TWILIO_AUTH_TOKEN="reemplazar-con-el-auth-token-de-twilio"
TWILIO_WHATSAPP_FROM="whatsapp:+14155238886"

# Content SID de la plantilla de Twilio "Quick Reply" (botones táctiles
# Sí/No) — se crea una sola vez en Twilio Content API/Console y se reusa
# para todas las confirmaciones del bot.
TWILIO_CONTENT_SID_SI_NO="HXxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx"

# URL pública de este proyecto (sin barra final) — Twilio la necesita para
# validar la firma del webhook. En local con ngrok, la URL de ngrok.
PUBLIC_APP_URL="https://stockasist-api.vercel.app"
