DATABASE_URL="postgresql://postgres:postgres@localhost:5432/fauna_de_tela?schema=public"

JWT_SECRET="reemplazar-con-un-secreto-largo-y-aleatorio"
JWT_EXPIRES_IN="7d"

CORS_ORIGIN="http://localhost:5173"

# Usados solo por prisma/seed.ts para crear la cuenta inicial del dueño
OWNER_EMAIL="dueno@ejemplo.com"
OWNER_PASSWORD="elegir-una-contraseña-segura"
OWNER_NOMBRE="Dueño"

# Bot de WhatsApp (Twilio Sandbox) — ver README sección "WhatsApp"
TWILIO_ACCOUNT_SID="ACxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx"
TWILIO_AUTH_TOKEN="reemplazar-con-el-auth-token-de-twilio"
TWILIO_WHATSAPP_FROM="whatsapp:+14155238886"
OWNER_WHATSAPP_NUMBER="whatsapp:+549..."

# URL pública del backend (sin barra final) — Twilio la necesita para
# validar la firma del webhook. En local con ngrok, la URL de ngrok.
PUBLIC_APP_URL="https://backend-production-xxxx.up.railway.app"
